{
	"include": [
		"$(MODULES)/drivers/button/manifest.json",
		"$(MODULES)/drivers/neopixel/manifest.json",		
		"$(MODULES)/drivers/ssd1963_p16/manifest.json",
		"$(MODULES)/drivers/ft5x06/manifest.json"
	],
	"build":{
		"ESP32_SUBCLASS": "esp32s3"
	},
	"modules": {
		"setup/target": "./setup-target"
	},
	"preload": [
		"setup/target",
		"neopixel"
	],
	"config": {
		"screen": "ssd1963_p16",
		"touch": "ft5x06",
		"rotation": 90,
		"led": {
			"pin": 48,
			"rainbow": false,
			"brightness": 32
		}
	},
	"creation": {
		"static": 0,
		"chunk": {
			"initial": 78848,
			"incremental": 0
		},
		"heap": {
			"initial": 4928,
			"incremental": 0
		},
		"stack": 512
	},
	"defines": {
		"ft5x06": {
			"width": 480,
			"height": 272,
			"hz": 400000,
			"sda": 9,
			"scl": 21,
			"threshold": 128,
			"flipX": true,
			"flipY": true,
			"fitX": false,
			"fitY": false
		},
		"spi": {
			"miso_pin":37,
			"mosi_pin":35,
			"sck_pin": 36
		},
		"ssd1963p16": {
			"hz": 30000000,
			"cs_pin": 40,
			"dc_pin": 7,			
			"pclk_pin": 11,
			"data0_pin": 15, "data1_pin": 48, "data2_pin": 16, "data3_pin": 47,
			"data4_pin": 18, "data5_pin": 17, "data6_pin": 8,  "data7_pin": 5,
			"data8_pin": 3, "data9_pin": 14, "data10_pin": 12, "data11_pin": 13,
			"data12_pin": 38, "data13_pin": 41, "data14_pin": 4,  "data15_pin": 1,
			"rst_pin": 10
		}
	}
}
